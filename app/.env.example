# Copy to app/.env and fill in. Only build.ts loads this file (via dotenv);
# the server does not, so set server variables in the shell instead.

# MapTiler API key for the hillshade tiles. Required: the build exits without
# it. esbuild inlines it into the client bundle, so it is public by design.
MAPTILER_KEY=your_maptiler_api_key_here

# --- Set these in the shell, not in this file ---

# Port the Express server listens on. Default: 3300.
# PORT=3300

# `production` makes build.ts emit the single minified bundle (npm run
# build:prod sets it; in .env it would turn `npm run dev` into a production
# build too). The server tags analytics events as production only
# when this is set and HOSTNAME does not contain `localhost`.
# NODE_ENV=production

# Read only for the analytics environment tag; see NODE_ENV.
# HOSTNAME=localhost
