{
  "name": "mch-precipitation-clone",
  "version": "1.0.0",
  "description": "Meteo Swiss Precipitation Clone",
  "scripts": {
    "build:prod": "NODE_ENV=production ts-node build.ts",
    "dev": "concurrently \"npm run server\" \"npm run watch\"",
    "lint:config": "npx @eslint/config-inspector",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:fix": "eslint . --fix",
    "lint": "eslint .",
    "server": "ts-node-dev --respawn server.ts",
    "watch": "ts-node build.ts"
  },
  "dependencies": {
    "@umami/node": "^0.4.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-http-proxy": "^2.1.2",
    "express-rate-limit": "^8.3.2",
    "maplibre-gl": "^5.21.1"
  },
  "devDependencies": {
    "@eslint/config-inspector": "^1.5.0",
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.58.1",
    "@html-eslint/parser": "^0.58.1",
    "@types/express": "^5.0.6",
    "@types/express-http-proxy": "^1.6.7",
    "@types/node": "^25.5.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.4",
    "eslint": "^10.1.0",
    "glob": "^13.0.6",
    "globals": "^17.4.0",
    "stylelint": "^17.6.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.2"
  }
}