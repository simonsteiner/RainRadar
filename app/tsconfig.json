{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    // Node strips types rather than compiling them, so anything that needs a
    // real transform (enums, namespaces, parameter properties) must not appear.
    // This makes tsc reject that syntax instead of leaving it to fail at runtime.
    "erasableSyntaxOnly": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["*.ts", "server/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
